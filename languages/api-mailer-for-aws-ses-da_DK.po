#. Plugin Name of the plugin
#: ses-mailer.php src/Admin/AdminPage.php:21 src/Admin/AdminPage.php:22
#: src/Admin/AdminPage.php:79
msgid "API Mailer for AWS SES"
msgstr "WP API Mailer til AWS SES"

#. Description of the plugin
#: ses-mailer.php
msgid "Fast, lightweight WordPress mailer that sends via Amazon SES SendRawEmail API (no SMTP). Includes background queue, logging, and wp-config credentials."
msgstr "Hurtig, letvægts WordPress-mailer, der sender via Amazon SES SendRawEmail API (ingen SMTP). Inkluderer baggrundskø, logning og wp-config-legitimationsoplysninger."

#. Author of the plugin
#: ses-mailer.php
msgid "beltoft.net"
msgstr "beltoft.net"

#. Author URI of the plugin
#: ses-mailer.php
msgid "https://beltoft.net"
msgstr "https://beltoft.net"

